# Exemplo de configuração de PRODUÇÃO do Cuidar+.
# Copie para .env no servidor e ajuste. Nunca versione o .env real.

APP_NAME="Cuidar+"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://cuidarplus.exemplo.br

# Domínio usado pelo nginx para o certificado e o server_name.
DOMINIO=cuidarplus.exemplo.br

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR
# Os lembretes são horários do dia do paciente: o fuso precisa ser o local.
APP_TIMEZONE=America/Sao_Paulo

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

# --- Banco de dados ---
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=cuidar_plus
DB_USERNAME=cuidar
DB_PASSWORD=trocar-por-uma-senha-forte
DB_ROOT_PASSWORD=trocar-por-outra-senha-forte

# --- Sessão ---
SESSION_DRIVER=database
SESSION_LIFETIME=120
# Cookie de sessão só trafega em HTTPS e não é acessível por JavaScript.
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_ENCRYPT=true

FILESYSTEM_DISK=local
CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=reverb

# --- Laravel Reverb ---
REVERB_APP_ID=trocar
REVERB_APP_KEY=trocar
REVERB_APP_SECRET=trocar-por-um-segredo-forte
# Comunicação interna entre a aplicação e o Reverb, dentro da rede do compose.
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

# O NAVEGADOR conecta pelo domínio público, em wss:// — nunca ws:// puro,
# porque a sessão do paciente vai no handshake.
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=cuidarplus.exemplo.br
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="contato@cuidarplus.exemplo.br"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
