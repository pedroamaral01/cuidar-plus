APP_NAME="Cuidar+"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR
APP_TIMEZONE=America/Sao_Paulo

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Portas expostas no host (docker compose) ---
APP_PORT=8080
VITE_PORT=5173
DB_PORT_EXTERNO=3306
REVERB_PORT_EXTERNO=8081

# --- Banco de dados ---
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=cuidar_plus
DB_USERNAME=cuidar
DB_PASSWORD=secret
DB_ROOT_PASSWORD=root

# Banco usado pela suíte de testes (criado pelo init do container MySQL)
DB_DATABASE_TESTE=cuidar_plus_teste

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

FILESYSTEM_DISK=local

# Notificações: database (persistente) + broadcast em tempo real via Reverb.
# As Notifications implementam ShouldQueue, então o serviço `queue` precisa estar de pé.
BROADCAST_CONNECTION=reverb
QUEUE_CONNECTION=database

CACHE_STORE=database

# --- Laravel Reverb (WebSocket) ---
REVERB_APP_ID=cuidar-plus
REVERB_APP_KEY=cuidarpluskey
REVERB_APP_SECRET=cuidarplussecret
# Host/porta que o BACKEND usa para publicar eventos no Reverb (rede interna do compose)
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

# Host/porta que o NAVEGADOR usa: passa pelo nginx, que faz o upgrade para WebSocket
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http

MAIL_MAILER=log
MAIL_FROM_ADDRESS="contato@cuidarplus.local"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
